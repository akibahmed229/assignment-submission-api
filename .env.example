# Copy this file to .env and replace placeholder values before running.
# NEVER commit your actual .env file to version control!

# ==============================================================================
# Database Configuration
# ==============================================================================
POSTGRES_DB=assignment_submission_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Note: Use 'localhost' when running the API directly via dotnet run.
# Docker Compose will override 'localhost' to 'postgres' inside the container.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_submission_db;Username=postgres;Password=changeme

# ==============================================================================
# JWT Authentication
# ==============================================================================
# Must be at least 32 characters long for HMAC-SHA256
Jwt__Secret=your_super_secret_key_that_is_at_least_32_chars_long
Jwt__Issuer=AssignmentSubmissionSystem
Jwt__Audience=AssignmentSubmissionSystemClient
Jwt__ExpiryMinutes=60

# ==============================================================================
# Seed Data / Demo Accounts
# ==============================================================================
# Used by DbInitializer on application startup
Seed__AdminPassword=Admin@12345
Seed__TeacherPassword=Teacher@12345
Seed__StudentPassword=Student@12345

# ==============================================================================
# Application Environment
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Development
